{
  "name": "goodcall",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "description": "GoodCall React SPA",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.6.0",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:styles": "stylelint src/**/*.scss",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build --base=/GoodCall/",
    "prepare:pages": "node scripts/prepare-pages-artifact.mjs",
    "report:sizes": "node scripts/report-bundle-sizes.mjs",
    "validate:build": "node scripts/validate-build.mjs",
    "preview": "vite preview --base=/GoodCall/",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run lint:styles && npm run format:check",
    "check:full": "npm run typecheck && npm run lint && npm run lint:styles && npm run format:check && npm test && npm run build && npm run prepare:pages && npm run validate:build && npm run test:e2e"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "@tanstack/react-query": "^5.101.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.13.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.9.0",
    "@typescript-eslint/parser": "^8.9.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/ui": "^1.6.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^15.0.7",
    "@testing-library/user-event": "^14.5.2",
    "@axe-core/playwright": "^4.12.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.9.0",
    "globals": "^15.0.0",
    "eslint-plugin-react": "^7.34.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "jsdom": "^24.1.0",
    "@playwright/test": "^1.62.1",
    "playwright": "^1.62.1",
    "postcss": "^8.4.38",
    "prettier": "^3.3.0",
    "sass-embedded": "^1.77.6",
    "stylelint": "^16.6.0",
    "stylelint-config-standard-scss": "^13.1.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^1.6.0",
    "msw": "^2.2.8"
  }
}
